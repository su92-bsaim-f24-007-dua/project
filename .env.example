# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SESSION_SECRET: Secret used to sign session tokens and QR ticket signatures.
# Falls back to an ephemeral cryptographic key in development if unset.
SESSION_SECRET=

# ADMIN_PASSCODE: Optional server-side admin bootstrap passcode.
# If unset, the first-run Admin Claim form lets you set the initial admin password.
ADMIN_PASSCODE=
